{
  "type": "object",
  "properties": {
    "schema": {"type": "string", "enum": ["chronos.case-explanation-plan.v1"]},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "context_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "catalog_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "topic": {"type": "string", "enum": ["DECISION", "COMPARISON", "OPERATION_STATUS", "PHYSICAL_DELIVERY", "PREFERENCE_CHANGE", "APPROVAL_REQUIREMENTS", "CLARIFY"]},
    "detail": {"type": "string", "enum": ["concise", "detailed"]},
    "preference": {"anyOf": [{"type": "null"}, {"type": "string", "enum": ["CHEAPEST_ON_TIME", "EARLIEST_ALLOWED"]}]}
  },
  "required": ["schema", "conversation_id", "turn_id", "context_digest", "catalog_digest", "topic", "detail", "preference"],
  "additionalProperties": false
}
