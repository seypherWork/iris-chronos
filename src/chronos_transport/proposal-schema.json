{
  "type": "object",
  "properties": {
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "chronos.agent-proposal.v1"
      ]
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "shipment_version": {
      "type": "integer",
      "minimum": 0
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "enum": [
        "RETRY_A",
        "FAILOVER_B",
        "HOLD"
      ]
    },
    "option_id": {
      "enum": [
        "opt-a",
        "opt-b",
        null
      ]
    },
    "interpreted_preference": {
      "type": "string",
      "enum": [
        "CHEAPEST_ON_TIME",
        "EARLIEST_ALLOWED",
        "UNRESOLVED",
        "NOT_USED"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "PREFERENCE_MATCH",
        "ACCEPTANCE_UNRESOLVED",
        "CONTEXT_AMBIGUOUS",
        "CONFLICTING_EVIDENCE",
        "NO_FEASIBLE_OPTION",
        "CONTEXT_INCOMPLETE"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "clarification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      ]
    }
  },
  "required": [
    "context_id",
    "order_id",
    "schema_version",
    "context_digest",
    "shipment_version",
    "state_revision",
    "action",
    "option_id",
    "interpreted_preference",
    "source_ids",
    "reason_code",
    "rationale",
    "clarification"
  ],
  "additionalProperties": false
}